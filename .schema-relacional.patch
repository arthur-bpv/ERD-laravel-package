diff --git a/tests/Feature/SchemaBoardTest.php b/tests/Feature/SchemaBoardTest.php
index a0d3db4..a81afa0 100644
--- a/tests/Feature/SchemaBoardTest.php
+++ b/tests/Feature/SchemaBoardTest.php
@@ -301,4 +301,84 @@ public function test_dragging_a_node_persists_its_position(): void
         $this->assertSame(124, $posts['x']);
         $this->assertSame(456, $posts['y']);
     }
+
+    // ---------------------------------------------------------------------
+    // Modo de visualização — Chen ↔ schema relacional
+    // ---------------------------------------------------------------------
+
+    /** O canvas nasce na notação de Chen: losango + pé de galinha nas duas pontas. */
+    public function test_view_mode_defaults_to_er_with_diamond_and_crows_feet(): void
+    {
+        $component = Livewire::test(SchemaBoard::class);
+
+        $this->assertSame('er', $component->get('viewMode'));
+
+        $edges = $component->instance()->buildEdges();
+        $this->assertSame('escreve', $edges[0]['label']);
+        $this->assertIsArray($edges[0]['markerStart']);
+        $this->assertIsArray($edges[0]['markerEnd']);
+    }
+
+    /**
+     * Alternar o modo troca o formato de TODAS as arestas de uma vez e avisa
+     * o cliente em lote — é o `erd-rebuild-edges` que o JS usa pra fazer
+     * remove → aguardar frames → add sem perder o marcador novo.
+     */
+    public function test_toggling_view_mode_switches_to_relational_edges(): void
+    {
+        $component = Livewire::test(SchemaBoard::class)
+            ->call('toggleViewMode')
+            ->assertDispatched('erd-rebuild-edges', function (string $name, array $params) {
+                // Nenhuma aresta pode carregar losango ou seta na origem
+                // nesse modo — só a seta simples apontando pra PK.
+                foreach ($params['edges'] as $edge) {
+                    if (array_key_exists('label', $edge)) {
+                        return false;
+                    }
+                    if (array_key_exists('markerStart', $edge)) {
+                        return false;
+                    }
+                    if (($edge['markerEnd']['type'] ?? null) !== 'arrow') {
+                        return false;
+                    }
+                }
+
+                return count($params['edges']) === 3;
+            });
+
+        $this->assertSame('relational', $component->get('viewMode'));
+
+        // O modelo continua o mesmo — só a representação visual mudou.
+        $this->assertCount(3, $component->get('relations'));
+        $this->assertSame('escreve', $this->relacao($component->get('relations'), 'r1')['name']);
+    }
+
+    /** Alternar de novo volta para a notação de Chen, losango e tudo. */
+    public function test_toggling_view_mode_twice_restores_chen_edges(): void
+    {
+        $component = Livewire::test(SchemaBoard::class)
+            ->call('toggleViewMode')
+            ->call('toggleViewMode');
+
+        $this->assertSame('er', $component->get('viewMode'));
+
+        $edges = $component->instance()->buildEdges();
+        $this->assertSame('escreve', $edges[0]['label']);
+        $this->assertIsArray($edges[0]['markerStart']);
+    }
+
+    /**
+     * Os nodes carregam o modo atual em `data.viewMode` — é o que o Blade lê
+     * pra trocar a casca visual da entidade (cabeçalho neutro, sem coluna de
+     * tipo) sem duplicar o template do node.
+     */
+    public function test_nodes_publish_the_current_view_mode(): void
+    {
+        $component = Livewire::test(SchemaBoard::class)->call('toggleViewMode');
+
+        $nodes = $component->instance()->buildNodes();
+        foreach ($nodes as $node) {
+            $this->assertSame('relational', $node['data']['viewMode']);
+        }
+    }
 }
