+++ b/resources/css/erd.css
@@ -180,6 +180,48 @@ .er-add-confirm {
 }
 .er-add-confirm:hover { background: #15803d; }
 
+/*
+ * ---- MODO SCHEMA RELACIONAL ----
+ *
+ * Aplicado via `.er-node-relational` (node.data.viewMode === 'relational',
+ * publicado por SchemaBoard::nodeData). É só uma casca visual por cima do
+ * MESMO template do node — sem duplicar HTML: cabeçalho neutro (sem o roxo
+ * do modo Chen), sem coluna de tipo e sem o contador de relações (relCount
+ * é conceito de Chen), e a PK ganha negrito além do sublinhado que ela já
+ * tinha — o resultado lembra os diagramas "de livro-texto" de schema
+ * relacional (ver erdplus.png de referência).
+ */
+.er-node-relational .er-head {
+    background: #f1f5f9;
+    color: #0f172a;
+}
+.er-node-relational .er-head.is-orphan { background: #fef2f2; color: #991b1b; }
+.er-node-relational .er-head-icon,
+.er-node-relational .er-head-rels {
+    display: none;
+}
+/* o botão de excluir era branco-sobre-branco no cabeçalho claro deste modo */
+.er-node-relational .er-head-del {
+    background: rgba(15, 23, 42, .08);
+    color: #475569;
+}
+.er-node-relational .er-head-del:hover { background: rgba(220, 38, 38, .15); color: #dc2626; }
+.er-node-relational .er-attr-type {
+    display: none;
+}
+/*
+ * Sem a coluna de tipo, o auto-placement do grid empurraria o botão de
+ * excluir pra perto do nome (ele viraria o próximo item "vivo" na
+ * sequência). Fixamos ele na 5ª faixa (16px) do template original — a
+ * mesma que ele já ocupava — pra continuar rente à borda direita da linha.
+ */
+.er-node-relational .er-attr-del {
+    grid-column: 5;
+}
+.er-node-relational .er-row.is-pk .er-attr-name {
+    font-weight: 800;
+}
+
 /*
