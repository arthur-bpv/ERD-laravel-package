diff --git a/resources/js/erd/edge-editor.js b/resources/js/erd/edge-editor.js
index 2d12471..7bcf678 100644
--- a/resources/js/erd/edge-editor.js
+++ b/resources/js/erd/edge-editor.js
@@ -84,6 +84,30 @@ document.addEventListener('alpine:init', () => {
                     if (select) flow.selectedEdges?.add(edge.id);
                 });
             });
+
+            /*
+             * Troca de modo de visualização (ER ↔ schema relacional), pedida
+             * pelo botão do cabeçalho via SchemaBoard::toggleViewMode().
+             *
+             * Mesma história do `erd-rebuild-edge` singular, só que em lote:
+             * o servidor manda TODAS as arestas já no formato do novo modo
+             * (losango+pé de galinha OU seta simples) num único payload, e o
+             * cliente é quem sabe esperar um frame real do navegador entre o
+             * remove e o add — sem isso o SVG reaproveitado ignora o
+             * marker-start/marker-end novo (ver a nota grande em
+             * mutateRelation() no SchemaBoard).
+             */
+            this.$wire.on('erd-rebuild-edges', ({ edges }) => {
+                const flow = this.$flow;
+                if (!flow || !edges) return;
+
+                const ids = edges.map((edge) => edge.id);
+                if (ids.length) flow.removeEdges(ids);
+
+                apósUmFrameDeVerdade(() => {
+                    if (edges.length) flow.addEdges(edges);
+                });
+            });
         },
     }));
 
